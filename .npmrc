# styled-jsx is a dependency of next, not of the docs app. The OpenNext bundler
# resolves require("styled-jsx/style") from the app directory, so hoist it to
# the workspace root where that lookup can find it.
# Setting the option replaces pnpm's defaults, so restore them too.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=styled-jsx
